{
  "$comment": "This file is synced with stordco/common-config-elixir. Any changes will be overwritten. To override specific fields, create a release-please-config-stable.overrides.json file in this directory.",
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features",
      "hidden": false
    },
    {
      "type": "fix",
      "section": "Bug Fixes",
      "hidden": false
    },
    {
      "type": "chore",
      "section": "Miscellaneous",
      "hidden": false
    },
    {
      "type": "docs",
      "section": "Miscellaneous",
      "hidden": false
    }
  ],
  "draft": false,
  "draft-pull-request": false,
  "packages": {
    ".": {
      "release-type": "php"
    }
  },
  "plugins": [
    {
      "type": "sentence-case"
    }
  ],
  "prerelease": false,
  "pull-request-header": "An automated release has been created for you.",
  "separate-pull-requests": true,
  "include-component-in-tag": false,
  "include-v-in-tag": false
}
